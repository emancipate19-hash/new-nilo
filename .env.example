# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION:
# Enter your Telegram BotFather token here in the AI Studio Secrets / Environment Variables panel.
TELEGRAM_BOT_TOKEN=
# Target Telegram group/channel/chat ID (Default: -1004345720712)
TELEGRAM_CHAT_ID=-1004345720712
